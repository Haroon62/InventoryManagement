@model IEnumerable<InventoryManagement.ViewModels.ProductListViewModel>
@{
    ViewData["Title"] = "Products";
    var searchTerm = ViewData["SearchTerm"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800">Products</h1>
    <a asp-action="AddEdit" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i> New Product
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent py-3">
        <!-- Search Form -->
        <form asp-action="Index" method="get" class="d-flex w-100 max-w-md">
            <div class="input-group">
                <span class="input-group-text bg-transparent border-end-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="search" value="@searchTerm" class="form-control border-start-0 ps-0" placeholder="Search by SKU or Name...">
                <button type="submit" class="btn btn-outline-secondary">Search</button>
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>
    
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">SKU</th>
                        <th>Name</th>
                        <th>Current Stock</th>
                        <th>Reorder Level</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 font-monospace small">@item.Sku</td>
                                <td class="fw-medium">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-primary">
                                        @item.Name
                                    </a>
                                </td>
                                <td>
                                    @if (item.IsLowStock)
                                    {
                                        <span class="badge badge-outline-danger" title="Stock is at or below reorder level">
                                            @item.CurrentStock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-outline-success">@item.CurrentStock</span>
                                    }
                                </td>
                                <td class="text-muted">@item.ReorderLevel</td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary shadow-sm" title="View Details & Add Movement">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                        <a asp-action="AddEdit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary shadow-sm" title="Edit Product">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger shadow-sm" title="Delete Product">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-search display-4 opacity-50 mb-3 d-block"></i>
                                No products found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
