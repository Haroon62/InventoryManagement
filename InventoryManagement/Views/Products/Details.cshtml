@model InventoryManagement.ViewModels.ProductDetailViewModel
@using InventoryManagement.Enums
@{
    ViewData["Title"] = Model.Product.Name;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted mb-2 d-inline-block">
            <i class="bi bi-arrow-left me-1"></i> Back to Products
        </a>
        <h1 class="h3 mb-0 text-gray-800 d-flex align-items-center gap-2">
            @Model.Product.Name
            @if (Model.CurrentStock <= Model.Product.ReorderLevel)
            {
                <span class="badge bg-danger fs-6">Low Stock</span>
            }
        </h1>
    </div>
    <a asp-action="AddEdit" asp-route-id="@Model.Product.Id" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-pencil me-1"></i> Edit Product
    </a>
</div>

<div class="row g-4 mb-4">
    <!-- Product Details Card -->
    <div class="col-md-4">
        <div class="card border-0 shadow h-100">
            <div class="card-header bg-transparent py-3">
                <h5 class="card-title mb-0">Product Info</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted fw-normal">SKU</dt>
                    <dd class="col-sm-7 font-monospace">@Model.Product.Sku</dd>

                    <dt class="col-sm-5 text-muted fw-normal">Current Stock</dt>
                    <dd class="col-sm-7 fw-bold fs-5">
                        <span class="@(Model.CurrentStock <= Model.Product.ReorderLevel ? "text-danger" : "text-success")">
                            @Model.CurrentStock
                        </span>
                    </dd>

                    <dt class="col-sm-5 text-muted fw-normal">Reorder Level</dt>
                    <dd class="col-sm-7">@Model.Product.ReorderLevel</dd>

                    <dt class="col-sm-5 text-muted fw-normal">Created</dt>
                    <dd class="col-sm-7">@Model.Product.CreatedUtc.ToLocalTime().ToString("MMM dd, yyyy")</dd>

                    <dt class="col-sm-12 text-muted fw-normal mt-3">Description</dt>
                    <dd class="col-sm-12">
                        @(string.IsNullOrEmpty(Model.Product.Description) ? "No description provided." : Model.Product.Description)
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Record Movement Form Card -->
    <div class="col-md-8">
        <div class="card border-0 shadow h-100">
            <div class="card-header bg-transparent py-3">
                <h5 class="card-title mb-0">Record Stock Movement</h5>
            </div>
            <div class="card-body">
                <form asp-action="AddMovement" method="post" class="needs-validation" novalidate onsubmit="if(!this.checkValidity()){event.preventDefault();event.stopPropagation();}this.classList.add('was-validated');">
                    <input type="hidden" asp-for="NewMovement.ProductId" />
                    
                    <div class="row g-3 mb-3">
                        <div class="col-md-5">
                            <label class="form-label d-block">Movement Type</label>
                            <div class="btn-group w-100" role="group">
                                <input type="radio" class="btn-check" name="NewMovement.MovementType" id="moveIn" value="0" required>
                                <label class="btn btn-outline-success" for="moveIn">
                                    <i class="bi bi-box-arrow-in-down me-1"></i> Stock IN
                                </label>

                                <input type="radio" class="btn-check" name="NewMovement.MovementType" id="moveOut" value="1" required>
                                <label class="btn btn-outline-danger" for="moveOut">
                                    <i class="bi bi-box-arrow-up me-1"></i> Stock OUT
                                </label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NewMovement.Quantity" class="form-label">Quantity</label>
                            <div class="input-group has-validation">
                                <span class="input-group-text bg-transparent text-muted"><i class="bi bi-hash"></i></span>
                                <input asp-for="NewMovement.Quantity" class="form-control border-start-0 ps-0" placeholder="e.g. 50" min="1" required />
                                <div class="invalid-feedback">Valid quantity (>0) required.</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="NewMovement.Note" class="form-label">Note (Optional)</label>
                        <input asp-for="NewMovement.Note" class="form-control" placeholder="e.g. Received from Supplier X" />
                    </div>
                    
                    <button type="submit" class="btn btn-primary px-4 mt-2">
                        <i class="bi bi-save me-1"></i> Record Movement
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Movement History Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Movement History</h5>
        <span class="text-muted small"><i class="bi bi-clock-history me-1"></i> Chronological log</span>
    </div>
    <div class="card-body p-0">
        @if (Model.MovementHistory.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Date / Time (Local)</th>
                            <th>Type</th>
                            <th>Quantity</th>
                            <th>Note</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var movement in Model.MovementHistory)
                        {
                            <tr>
                                <td class="ps-4 text-muted small">@movement.CreatedUtc.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                                <td>
                                    @if (movement.MovementType == MovementType.In)
                                    {
                                        <span class="badge badge-outline-success"><i class="bi bi-arrow-down-left me-1"></i> IN</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-outline-danger"><i class="bi bi-arrow-up-right me-1"></i> OUT</span>
                                    }
                                </td>
                                <td class="fw-medium">@movement.Quantity</td>
                                <td class="text-muted">@movement.Note</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-journal-x display-4 opacity-50 mb-3 d-block"></i>
                <p class="mb-0">No stock movements recorded yet.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
