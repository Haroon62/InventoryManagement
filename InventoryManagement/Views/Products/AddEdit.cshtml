@model InventoryManagement.ViewModels.ProductFormViewModel
@{
    bool isCreate = Model.Id == 0;
    ViewData["Title"] = isCreate ? "Create Product" : "Edit Product";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted mb-2 d-inline-block">
            <i class="bi bi-arrow-left me-1"></i> Back to Products
        </a>
        <h1 class="h3 mb-0 text-gray-800">@(isCreate ? "Create New Product" : "Edit Product")</h1>
    </div>
</div>

<div class="row">
    <!-- Make form full width by using col-12 -->
    <div class="col-12">
        <div class="card border-0 shadow">
            <div class="card-body p-4">
                <!-- Removed needs-validation and novalidate to use native browser validation -->
                <form asp-action="AddEdit" method="post">
                    <input type="hidden" asp-for="Id" />
                    
                    <div id="ajaxErrorAlert" class="alert alert-danger shadow-sm border-0 align-items-center mb-4 d-none" role="alert">
                        <i class="bi bi-exclamation-octagon-fill fs-4 me-3"></i>
                        <div id="ajaxErrorMessage" class="mb-0"></div>
                    </div>
                    
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger shadow-sm border-0 d-flex align-items-center mb-4 server-error" role="alert">
                            <i class="bi bi-exclamation-octagon-fill fs-4 me-3"></i>
                            <div asp-validation-summary="ModelOnly" class="mb-0"></div>
                        </div>
                    }
                    
                    <div class="mb-3">
                        <label asp-for="Sku" class="form-label">SKU (Stock Keeping Unit)</label>
                        <input asp-for="Sku" class="form-control" placeholder="e.g. WIDGET-001" required autofocus />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Product Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Product Name" required />
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="ReorderLevel" class="form-label">Reorder Level</label>
                        <div class="input-group has-validation">
                            <span class="input-group-text bg-transparent text-muted"><i class="bi bi-hash"></i></span>
                            <input asp-for="ReorderLevel" class="form-control border-start-0 ps-0" placeholder="0" min="0" required />
                        </div>
                        <div class="form-text text-muted mt-1"><i class="bi bi-info-circle me-1"></i>You will be alerted when stock falls to or below this level.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional details..."></textarea>
                    </div>

                    <div class="d-flex gap-2 pt-3 border-top mt-4">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i> @(isCreate ? "Create Product" : "Save Changes")
                        </button>
                        <a href="javascript:history.back()" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            var $form = $('form[action*="AddEdit"]');
            
            $form.on('submit', function (e) {
                if (!this.checkValidity()) return;
                
                e.preventDefault();
                var $btn = $form.find('button[type="submit"]');
                var originalText = $btn.html();
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Saving...');

                // Hide any existing server error blocks
                $('.server-error').addClass('d-none');
                $('#ajaxErrorAlert').addClass('d-none').removeClass('d-flex');

                $.ajax({
                    url: $form.attr('action'),
                    type: $form.attr('method'),
                    data: $form.serialize(),
                    success: function (res) {
                        if (res.success) {
                            // Redirect cleanly to Index page without pushing the POST request to history
                            window.location.replace(res.redirectUrl);
                        } else {
                            // Show error message
                            $('#ajaxErrorMessage').text(res.message || 'Validation failed.');
                            $('#ajaxErrorAlert').removeClass('d-none').addClass('d-flex');
                            $btn.prop('disabled', false).html(originalText);
                        }
                    },
                    error: function () {
                        $('#ajaxErrorMessage').text('A network error occurred.');
                        $('#ajaxErrorAlert').removeClass('d-none').addClass('d-flex');
                        $btn.prop('disabled', false).html(originalText);
                    }
                });
            });
        });
    </script>
}
