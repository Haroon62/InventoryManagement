@model InventoryManagement.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800">Dashboard</h1>
    <a asp-controller="Products" asp-action="AddEdit" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i> New Product
    </a>
</div>

<div class="row g-4 mb-4">
    <!-- Total SKUs Card -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="card-subtitle text-muted mb-0">Total SKUs</h6>
                    <div class="bg-primary bg-opacity-10 text-primary p-2 rounded">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>
                <h2 class="display-6 fw-semibold mb-0">@Model.TotalSkus</h2>
            </div>
        </div>
    </div>

    <!-- Low Stock Card -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="card-subtitle text-muted mb-0">Items Low on Stock</h6>
                    <div class="bg-warning bg-opacity-10 text-warning p-2 rounded">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                </div>
                <h2 class="display-6 fw-semibold mb-0">@Model.LowStockCount</h2>
            </div>
        </div>
    </div>
</div>

<!-- Low Stock Products List -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent py-3">
        <h5 class="card-title mb-0">Low Stock Alerts</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.LowStockProducts.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">SKU</th>
                            <th>Product Name</th>
                            <th>Current Stock</th>
                            <th>Reorder Level</th>
                            <th class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.LowStockProducts)
                        {
                            <tr>
                                <td class="ps-4 font-monospace small">@product.Sku</td>
                                <td class="fw-medium">@product.Name</td>
                                <td>
                                    <span class="badge badge-outline-danger">@product.CurrentStock</span>
                                </td>
                                <td>@product.ReorderLevel</td>
                                <td class="text-end pe-4">
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">
                                        Restock
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-check-circle display-4 text-success opacity-50 mb-3"></i>
                <p class="mb-0">All stock levels are healthy.</p>
            </div>
        }
    </div>
</div>
